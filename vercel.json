{
  "version": 2,
  "builds": [
    {
      "src": "index.php",
      "use": "@vercel/php"
    },
    {
      "src": "admin.php",
      "use": "@vercel/php"
    },
    {
      "src": "rsvp_handler.php",
      "use": "@vercel/php"
    }
  ],
  "routes": [
    { "src": "^/$", "dest": "/index.php" },
    { "src": "/index.php(.*)", "dest": "/index.php" },
    { "src": "/admin.php(.*)", "dest": "/admin.php" },
    { "src": "/rsvp_handler.php(.*)", "dest": "/rsvp_handler.php" }
  ]
}
